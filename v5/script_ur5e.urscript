def ur5e_dibujar():
  textmsg("=== UR5e: inicio del programa ===")
  q_home = get_actual_joint_positions()
  textmsg("UR5e HOME guardado")
  # === Ir al origen calibrado: UR5e ===
  textmsg("UR5e - yendo al origen calibrado")
  x0 = 0.68387
  y0 = -0.03000
  z_mesa = 0.00221
  rx = 2.48100
  ry = -1.92700
  rz = 0.00000
  # Primero se acerca por arriba; nunca va directamente a la Z baja.
  movel(p[x0, y0, z_mesa+0.06000, rx, ry, rz], a=0.03, v=0.05)
  sleep(0.3)
  # === Detección única de superficie por fuerza: UR5e ===
  textmsg("UR5e - Detectando superficie una sola vez...")
  zero_ftsensor()
  sleep(0.5)
  i_f = 0
  while (force() < 2.000 and i_f < 2000):
    speedl([0, 0, -0.00800, 0, 0, 0], 0.25, 0.02)
    i_f = i_f + 1
  end
  stopl(3.0)
  sleep(0.2)
  if (i_f >= 2000):
    popup("UR5e: No se detectó superficie. Revisa posición inicial y F_UMBRAL.", error=True)
    halt
  end
  z_contacto = get_actual_tcp_pose()[2]
  z_dibujo = z_contacto + 0.00150
  textmsg("UR5e - z_contacto=", z_contacto)
  textmsg("UR5e - z_dibujo=", z_dibujo)
  movel(p[x0, y0, z_dibujo+0.02500, rx, ry, rz], a=0.03, v=0.04)
  sleep(0.2)
  # === Dibujo - UR5e - 3 trazos ===

  # --- Trazo 1 / 3 ---
  textmsg("UR5e - Trazo 1 de 3")
  movel(p[x0+0.01300, y0+-0.00696, z_dibujo+0.02500, rx, ry, rz], a=0.03, v=0.04)
