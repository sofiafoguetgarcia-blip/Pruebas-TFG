  movel(p[x0+0.03064, y0+0.00635, z_dibujo, rx, ry, rz], a=0.008, v=0.025, r=0.0002)
  movel(p[x0+0.03002, y0+0.00851, z_dibujo, rx, ry, rz], a=0.008, v=0.025, r=0.0002)
  movel(p[x0+0.02879, y0+0.01099, z_dibujo, rx, ry, rz], a=0.008, v=0.025, r=0.0002)
  movel(p[x0+0.02538, y0+0.01470, z_dibujo, rx, ry, rz], a=0.008, v=0.025, r=0.0002)
