  movel(p[x0+0.02229, y0+0.01625, z_dibujo+0.02500, rx, ry, rz], a=0.03, v=0.04)

  # --- Trazo 3 / 3 ---
  textmsg("UR5e - Trazo 3 de 3")
  movel(p[x0+-0.01857, y0+0.01656, z_dibujo+0.02500, rx, ry, rz], a=0.03, v=0.04)
  movel(p[x0+-0.01857, y0+0.01656, z_dibujo, rx, ry, rz], a=0.006, v=0.002)
