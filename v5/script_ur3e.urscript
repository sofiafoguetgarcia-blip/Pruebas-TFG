def ur3e_dibujar():
  textmsg("=== UR3e: inicio del programa ===")
  q_home = get_actual_joint_positions()
  textmsg("UR3e HOME guardado")
  # === Ir al origen calibrado: UR3e ===
  textmsg("UR3e - yendo al origen calibrado")
  x0 = -0.52777
  y0 = -0.01601
  z_mesa = 0.00821
  rx = 1.34600
  ry = 2.83900
  rz = 0.00000
  # Primero se acerca por arriba; nunca va directamente a la Z baja.
  movel(p[x0, y0, z_mesa+0.06000, rx, ry, rz], a=0.03, v=0.05)
  sleep(0.3)
  # === Detección única de superficie por fuerza: UR3e ===
  textmsg("UR3e - Detectando superficie una sola vez...")
  zero_ftsensor()
  sleep(0.5)
  i_f = 0
  while (force() < 2.000 and i_f < 2000):
    speedl([0, 0, -0.00800, 0, 0, 0], 0.25, 0.02)
    i_f = i_f + 1
  end
  stopl(3.0)
  sleep(0.2)
  if (i_f >= 2000):
    popup("UR3e: No se detectó superficie. Revisa posición inicial y F_UMBRAL.", error=True)
    halt
  end
  z_contacto = get_actual_tcp_pose()[2]
  z_dibujo = z_contacto + 0.00150
  textmsg("UR3e - z_contacto=", z_contacto)
  textmsg("UR3e - z_dibujo=", z_dibujo)
  movel(p[x0, y0, z_dibujo+0.02500, rx, ry, rz], a=0.03, v=0.04)
  sleep(0.2)
  # === Dibujo - UR3e - 3 trazos ===

  # --- Trazo 1 / 3 ---
